generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Имена существующих таблиц сохранены через @map: миграция не теряет данные.
model User {
  id           String           @id @default(cuid())
  localKey     String?          @unique
  name         String           @default("Исследователь")
  onboarded    Boolean          @default(false)
  lastLessonId String?
  createdAt    DateTime         @default(now())
  settings     Settings?
  courses      CourseProgress[]
  progress     LessonProgress[]
  bookmarks    Bookmark[]
  attempts     ExerciseAttempt[]
  exerciseStats ExerciseStats[]
  quizAttempts QuizAttempt[]
  drafts       Draft[]
  studyDays    StudyDay[]
  @@map("Profile")
}

model Settings {
  userId    String @id
  dailyGoal Int    @default(30)
  compiler  String @default("gcc")
  fontSize  Int    @default(15)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseProgress {
  id               String   @id @default(cuid())
  userId           String
  courseId         String
  completedLessons Int      @default(0)
  totalLessons     Int      @default(0)
  percent          Float    @default(0)
  lastLessonId     String?
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, courseId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String    @map("profileId")
  lessonId       String
  read           Boolean   @default(false)
  quizPassed     Boolean   @default(false)
  practicePassed Boolean   @default(false)
  completedAt    DateTime?
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId], map: "Progress_profileId_lessonId_key")
  @@map("Progress")
}

model ExerciseAttempt {
  id        String   @id @default(cuid())
  userId    String   @map("profileId")
  lessonId  String
  mode      String
  source    String
  compiler  String
  standard  String
  stdin     String
  status    String
  result    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, lessonId, createdAt, id], map: "Attempt_userId_lessonId_createdAt_id_idx")
  @@map("Attempt")
}

model ExerciseStats {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  attempts       Int       @default(0)
  firstAttemptAt DateTime?
  lastAttemptAt  DateTime?
  successful     Boolean   @default(false)
  hintViewed     Boolean   @default(false)
  solutionViewed Boolean   @default(false)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId])
}

model QuizAttempt {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  answers   String
  score     Int
  total     Int
  passed    Boolean
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, lessonId, createdAt])
}

model Bookmark {
  id       String @id @default(cuid())
  userId   String @map("profileId")
  lessonId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId], map: "Bookmark_profileId_lessonId_key")
}

model Draft {
  id        String   @id @default(cuid())
  userId    String   @map("profileId")
  lessonId  String
  source    String
  stdin     String   @default("")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, lessonId], map: "Draft_profileId_lessonId_key")
}

model StudyDay {
  id     String @id @default(cuid())
  userId String @map("profileId")
  day    String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, day], map: "StudyDay_profileId_day_key")
}
