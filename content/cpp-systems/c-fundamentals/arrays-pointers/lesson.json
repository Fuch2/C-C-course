      "referenceSolution": "#include <stdio.h>\n#include <ctype.h>\n\nint count_vowels(const char *s) {\n    int count = 0;\n    for (int i = 0; s[i] != '\\0'; i++) {\n        int c = tolower((unsigned char)s[i]);\n        if (c == 'a' || c == 'e' || c == 'i' || c == 'o' || c == 'u') {\n            count++;\n        }\n    }\n    return count;\n}\n\nint main(void) {\n    char line[202];\n    while (fgets(line, sizeof(line), stdin) != NULL) {\n        printf(\"%d\\n\", count_vowels(line));\n    }\n    return 0;\n}\n",
