        "arguments": ["1000000000000000000"],
        "expected": "1\n"
      },
      {
        "id": "hidden-4",
        "name": "Скрытый тест 4",
        "arguments": ["123456789012345678"],
        "expected": "876543210987654321\n"
      },
      {
        "id": "hidden-5",
        "name": "Скрытый тест 5",
        "arguments": [10],
        "expected": "1\n"
      },
      {
        "id": "hidden-6",
        "name": "Скрытый тест 6",
        "arguments": [100],
        "expected": "1\n"
      },
      {
        "id": "hidden-7",
        "name": "Скрытый тест 7",
        "arguments": ["999999999999999999"],
        "expected": "999999999999999999\n"
      }
