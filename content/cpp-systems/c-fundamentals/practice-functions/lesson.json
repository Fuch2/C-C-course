      "referenceSolution": "#include <stdio.h>\n\nchar digit_char(int d) {\n    if (d < 10) {\n        return (char)('0' + d);\n    }\n    return (char)('A' + d - 10);\n}\n\nint main(void) {\n    long long n;\n    int base;\n    scanf(\"%lld %d\", &n, &base);\n    long long p = 1;\n    while (p <= n / base) {\n        p *= base;\n    }\n    while (p > 0) {\n        printf(\"%c\", digit_char((int)(n / p)));\n        n %= p;\n        p /= base;\n    }\n    printf(\"\\n\");\n    return 0;\n}\n",
