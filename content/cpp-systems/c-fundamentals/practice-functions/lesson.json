  "exercise": {
    "id": "c17-practice-functions-task-1",
    "title": "Перевёрнутое число",
    "description": "Напишите функцию `long long reverse_number(long long n)`, которая возвращает число, записанное цифрами `n` в обратном порядке. Ведущие нули результата пропадают: `reverse_number(1200)` равно 21.",
    "difficulty": "intermediate",
    "starterCode": "long long reverse_number(long long n) {\n    // Функцию main писать не нужно.\n    return 0;\n}\n",
    "language": "c",
    "standard": "c23",
    "compiler": "gcc",
    "examples": [
      {
        "input": "12345",
        "output": "54321\n"
      },
      {
        "input": "1200",
        "output": "21\n"
      }
    ],
    "constraints": ["0 ≤ n ≤ 10¹⁸."],
    "hints": [
      {
        "id": "hint-1",
        "text": "Цикл: result = result * 10 + n % 10; n /= 10.",
        "order": 1
      },
      {
        "id": "hint-2",
        "text": "Ведущие нули результата пропадают сами: для 1200 цикл получает цифры 0, 0, 2, 1, и результат растёт как 0 → 0 → 2 → 21.",
        "order": 2
      }
    ],
    "publicTests": [
      {
        "id": "case-1",
        "name": "Пример 1",
        "arguments": [12345],
        "expected": "54321\n"
      },
      {
        "id": "case-2",
        "name": "Пример 2",
        "arguments": [1200],
        "expected": "21\n"
      }
    ],
    "hiddenTests": [
      {
        "id": "hidden-1",
