          "expected": "2999\n"
        },
        {
          "id": "hidden-4",
          "name": "Скрытый тест 4",
          "arguments": [12321, 12321],
          "expected": "1\n"
        },
        {
          "id": "hidden-5",
          "name": "Скрытый тест 5",
          "arguments": [1000, 9999],
          "expected": "90\n"
