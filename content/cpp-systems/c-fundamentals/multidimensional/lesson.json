      "referenceSolution": "#include <stdio.h>\n\nint main(void) {\n    char field[50][50];\n    int n, m;\n    scanf(\"%d %d\", &n, &m);\n    for (int r = 0; r < n; r++) {\n        for (int c = 0; c < m; c++) {\n            scanf(\" %c\", &field[r][c]);\n        }\n    }\n    for (int r = 0; r < n; r++) {\n        for (int c = 0; c < m; c++) {\n            if (field[r][c] == '*') {\n                printf(\"*\");\n                continue;\n            }\n            int count = 0;\n            for (int dr = -1; dr <= 1; dr++) {\n                for (int dc = -1; dc <= 1; dc++) {\n                    int nr = r + dr, nc = c + dc;\n                    if (nr >= 0 && nr < n && nc >= 0 && nc < m && field[nr][nc] == '*') {\n                        count++;\n                    }\n                }\n            }\n            printf(\"%d\", count);\n        }\n        printf(\"\\n\");\n    }\n    return 0;\n}\n",
