      },
      {
        "id": "hidden-5",
        "name": "Много девяток",
        "stdin": "1999999999\n",
        "expected": "digit_sum(1999999999)\n  digit_sum(199999999)\n    digit_sum(19999999)\n      digit_sum(1999999)\n        digit_sum(199999)\n          digit_sum(19999)\n            digit_sum(1999)\n              digit_sum(199)\n                digit_sum(19)\n                  digit_sum(1)\n                  = 1\n                = 10\n              = 19\n            = 28\n          = 37\n        = 46\n      = 55\n    = 64\n  = 73\n= 82\n"
      },
      {
        "id": "hidden-6",
        "name": "Нули в середине",
        "stdin": "1000\n",
        "expected": "digit_sum(1000)\n  digit_sum(100)\n    digit_sum(10)\n      digit_sum(1)\n      = 1\n    = 1\n  = 1\n= 1\n"
      },
      {
        "id": "hidden-7",
