  "exercise": {
    "id": "algo-recursion-task-1",
    "title": "Двоичная запись",
    "description": "Каждая строка ввода — неотрицательное целое число. Напечатайте его двоичную запись без ведущих нулей (у нуля — `0`).\n\nРешите задачу рекурсией, без массивов и строк: функция сначала печатает старшие разряды, потом младший.",
    "difficulty": "beginner",
    "starterCode": "#include <stdio.h>\n\nint main(void) {\n    // Напишите решение здесь.\n    return 0;\n}\n",
    "language": "c",
    "standard": "c23",
    "compiler": "gcc",
    "diagnostics": "sanitizers",
    "examples": [
      {
        "input": "37\n",
        "output": "100101\n"
      },
      {
        "input": "0\n1\n2\n",
        "output": "0\n1\n10\n"
      }
    ],
    "constraints": ["0 ≤ n ≤ 4 294 967 295; строк не больше 30."],
    "hints": [
      {
        "id": "hint-1",
        "text": "Младший разряд — n % 2, остальные — двоичная запись n / 2.",
        "order": 1
      },
      {
        "id": "hint-2",
        "text": "Базовый случай — n < 2: число из одного разряда печатается сразу. Иначе — сначала рекурсивный вызов для n / 2, затем печать n % 2.",
        "order": 2
      }
    ],
    "publicTests": [
