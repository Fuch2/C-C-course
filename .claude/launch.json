{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/web.mjs", "dev", "apps/web", "--webpack", "-p", "3001"],
      "env": {
        "APP_ORIGIN": "http://localhost:3001"
      },
      "port": 3001
    },
    {
      "name": "runner-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:runner"],
      "port": 4001
    }
  ]
}
